<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Must match the runtime the game ships with (see SpaceEngineers2.runtimeconfig.json). -->
    <TargetFramework>net9.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>SE2VR</AssemblyName>
    <RootNamespace>SE2VR</RootNamespace>
    <Version>0.4.1</Version>
    <!-- Plugin: copy NuGet dependencies (0Harmony.dll) next to the output, but not the game's own assemblies. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\$(Configuration)\</OutputPath>
    <!-- Engine helpers marked [Obsolete("only for low level systems")] are used on purpose. -->
    <NoWarn>$(NoWarn);CS0618</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="Krafs.Publicizer" Version="2.3.2" PrivateAssets="all" />
  </ItemGroup>

  <!-- Game assemblies: referenced for compilation only, never copied to the output. -->
  <ItemGroup>
    <Reference Include="VRage.Library" HintPath="$(SE2GameDir)\VRage.Library.dll" Private="false" />
    <Reference Include="VRage.Core" HintPath="$(SE2GameDir)\VRage.Core.dll" Private="false" />
    <Reference Include="VRage.DCS" HintPath="$(SE2GameDir)\VRage.DCS.dll" Private="false" />
    <Reference Include="VRage.Render" HintPath="$(SE2GameDir)\VRage.Render.dll" Private="false" />
    <Reference Include="VRage.Render12" HintPath="$(SE2GameDir)\VRage.Render12.dll" Private="false" />
    <Reference Include="VRage.UI" HintPath="$(SE2GameDir)\VRage.UI.dll" Private="false" />
    <Reference Include="Game2.Client" HintPath="$(SE2GameDir)\Game2.Client.dll" Private="false" />
    <!-- The game's own Avalonia (UI) build, for the VR settings tab. -->
    <Reference Include="Avalonia.Base" HintPath="$(SE2GameDir)\Avalonia.Base.dll" Private="false" />
    <Reference Include="Avalonia.Controls" HintPath="$(SE2GameDir)\Avalonia.Controls.dll" Private="false" />
    <Reference Include="VRage.UI.Shared" HintPath="$(SE2GameDir)\VRage.UI.Shared.dll" Private="false" />
    <Reference Include="Vortice.Direct3D12" HintPath="$(SE2GameDir)\Vortice.Direct3D12.dll" Private="false" />
    <Reference Include="Vortice.DXGI" HintPath="$(SE2GameDir)\Vortice.DXGI.dll" Private="false" />
    <Reference Include="Vortice.DirectX" HintPath="$(SE2GameDir)\Vortice.DirectX.dll" Private="false" />
    <Reference Include="Vortice.Mathematics" HintPath="$(SE2GameDir)\Vortice.Mathematics.dll" Private="false" />
    <Reference Include="SharpGen.Runtime" HintPath="$(SE2GameDir)\SharpGen.Runtime.dll" Private="false" />
    <Reference Include="SharpGen.Runtime.COM" HintPath="$(SE2GameDir)\SharpGen.Runtime.COM.dll" Private="false" />
  </ItemGroup>

  <!-- The renderer is almost entirely internal; publicize it so the plugin can call it directly. -->
  <ItemGroup>
    <Publicize Include="VRage.Render" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="VRage.Render12" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="VRage.UI" IncludeCompilerGeneratedMembers="false" />
    <Publicize Include="Game2.Client" IncludeCompilerGeneratedMembers="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\config\SE2VR.json" Link="SE2VR.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
